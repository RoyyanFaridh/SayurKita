generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  phone      String   @unique
  password   String
  points     Int      @default(0)
  isVerified Boolean  @default(false)
  otpCode    String?
  otpExpires DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
