generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  phone      String   @unique
  password   String
  points     Int      @default(0)
  isVerified Boolean  @default(false)
  otpCode    String?
  otpExpires DateTime?
  streakCount    Int       @default(0)
  lastActiveDate DateTime?
  totalKarbonAkumulasi Float @default(0)
  poinKarbonAwarded    Int   @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ingredients Ingredient[]
  cookingLogs CookingLog[]
  poinLogs     PoinLog[]
}

model Ingredient {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nama        String
  kategori    String
  jumlah      String
  storage     String   @default("kulkas")
  beliDate    DateTime
  expDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CookingLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resepNama   String
  resepId     String?
  bahanUsed   Json     // array of { nama, karbon_co2e }
  totalKarbon Float
  createdAt   DateTime @default(now())

  @@index([userId])
}

model PoinLog {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta      Int         
  source     PoinSource
  note       String?
  refId      String?     
  createdAt  DateTime    @default(now())

  @@index([userId])
}

enum PoinSource {
  KARBON
  STREAK
}