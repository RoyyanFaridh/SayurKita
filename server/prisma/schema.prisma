datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis] // 👈 Tambahkan baris ini
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // 👈 Tambahkan ini agar Prisma mendukung ekstensi database
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  phone      String   @unique
  password   String
  points     Int      @default(0)
  isVerified Boolean  @default(false)
  otpCode    String?
  otpExpires DateTime?
  streakCount    Int       @default(0)
  lastActiveDate DateTime?
  totalKarbonAkumulasi Float @default(0)
  poinKarbonAwarded    Int   @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ingredients Ingredient[]
  surplusPosts SurplusPost[] @relation("PostedSurplus")
  receivedSurplus SurplusPost[] @relation("ReceivedSurplus")
  chatMessages  ChatMessage[]
  cookingLogs CookingLog[]
  poinLogs     PoinLog[]
}

model Ingredient {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nama        String
  kategori    String
  jumlah      String
  storage     String   @default("kulkas")
  beliDate    DateTime
  expDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

